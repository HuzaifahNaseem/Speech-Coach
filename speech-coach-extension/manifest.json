{
  "manifest_version": 3,
  "name": "Speech Coach",
  "version": "1.0",
  "description": "Live speech feedback during calls.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Open Speech Coach"
  },
  "options_page": "popup.html",
  "background": {
    "service_worker": "background.js"
  }
}